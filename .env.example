# Copy this file to .env before running Docker Compose.
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Never commit .env or reuse these values across deployments.

POSTGRES_DB=vigil_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Application role used by the API. It has SELECT/INSERT on clinical events
# and no UPDATE/DELETE/TRUNCATE privileges. Keep the owner credentials above
# for migrations only.
VIGIL_APP_DB_ROLE=vigil_app
VIGIL_APP_DB_PASSWORD=

SECRET_KEY=

VIGIL_ENV=production
VIGIL_AUTO_SEED=false
VIGIL_INTEGRITY_CHECK_INTERVAL_SECONDS=3600

# One-time bootstrap. Set a strong password and VIGIL_AUTO_SEED=true for the
# first startup, then set VIGIL_AUTO_SEED=false again.
VIGIL_SEED_ADMIN_PASSWORD=

# Demo staff/patients are for local development only. Never enable these in a
# real hospital deployment.
VIGIL_SEED_DEMO_USERS=false
VIGIL_SEED_DEMO_PASSWORD=
VIGIL_SEED_DEMO_PATIENTS=false

CORS_ORIGINS=http://localhost:3001

# Native backend only (Docker Compose constructs its own internal URLs).
# DATABASE_URL=postgresql://vigil_app:CHANGE_ME@127.0.0.1:5432/vigil_db
# MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/vigil_db
